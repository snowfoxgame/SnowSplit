    <string name="settings_help_title">Help &amp; Tips</string>
    <string name="settings_help_subtitle">Bubbles, Net vs. Gross, settling &amp; offline storage</string>
    <string name="settings_help_body">• Bubbles Map: Drag bubbles gently or tap a person to log debts, payments, or settle balances.\n• Net vs. Gross: Net offsets mutual debts automatically; Gross keeps credits and debts separate.\n• Offline-first: All contacts, photos, and entries stay locally on your device.</string>
    <string name="settings_about_title">App version</string>
    <string name="settings_about_subtitle">SnowSplit v%1$s (%2$d)</string>
    <string name="settings_about_body">SnowSplit %1$s\n\nAll debts, contacts, and custom backgrounds are stored locally on your device without any tracking or mandatory account. Optional theme sync with SnowDo\'s uses Android signature-level permissions only.</string>

    <string name="settings_section_calculation">Debt Calculation</string>
    <string name="settings_calc_net">Net (Offset)</string>
    <string name="settings_calc_gross">Gross (Separate)</string>
    <string name="settings_calc_net_desc">Offsets credits and debts per person automatically (e.g. 20 € credit + 60 € debt = You owe 40 €).</string>
    <string name="settings_calc_gross_desc">Shows green credits and red debts side by side until each side is settled separately.</string>

