        <!-- Required on Android < 13 for AppCompatDelegate.setApplicationLocales persistence -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name=".platform.sync.ThemeSyncContentProvider"
            android:authorities="${applicationId}.syncprovider"
            android:exported="true"
            android:permission="com.snowapps.permission.THEME_SYNC" />

        <receiver
            android:name=".platform.sync.ThemeSyncReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.snowapps.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="com.snowapps.action.APPEARANCE_SYNC" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
